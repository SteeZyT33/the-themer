// bleu theme for VS Code / Cursor
// Generated by the-themer — paste into "workbench.colorCustomizations"
{
    // ---- Terminal ----
    "terminal.background": "#050a14",
    "terminal.foreground": "#e0ecf4",
    "terminal.selectionBackground": "#2d4a6b",
    "terminal.selectionForeground": "#e0ecf4",
    "terminalCursor.foreground": "#5588cc",
    "terminal.ansiBlack": "#050a14",
    "terminal.ansiRed": "#A167A5",
    "terminal.ansiGreen": "#99FFE4",
    "terminal.ansiYellow": "#FDBD85",
    "terminal.ansiBlue": "#5588cc",
    "terminal.ansiMagenta": "#87ceeb",
    "terminal.ansiCyan": "#6bb6d6",
    "terminal.ansiWhite": "#e0ecf4",
    "terminal.ansiBrightBlack": "#2d4a6b",
    "terminal.ansiBrightRed": "#A167A5",
    "terminal.ansiBrightGreen": "#99FFE4",
    "terminal.ansiBrightYellow": "#FDBD85",
    "terminal.ansiBrightBlue": "#5588cc",
    "terminal.ansiBrightMagenta": "#87ceeb",
    "terminal.ansiBrightCyan": "#6bb6d6",
    "terminal.ansiBrightWhite": "#fefefe",

    // ---- Editor ----
    "editor.background": "#050a14",
    "editor.foreground": "#e0ecf4",
    "editorCursor.foreground": "#5588cc",
    "editor.selectionBackground": "#2d4a6b",
    "editor.lineHighlightBackground": "#070e1c28",
    "editorLineNumber.foreground": "#708090",
    "editorLineNumber.activeForeground": "#00d4ff",
    "editorIndentGuide.background1": "#2d4a6b28",
    "editorBracketMatch.background": "#00d4ff1e",
    "editorBracketMatch.border": "#00d4ff",

    // ---- Sidebar ----
    "sideBar.background": "#050a14",
    "sideBar.foreground": "#e0ecf4",
    "sideBar.border": "#2d4a6b",
    "sideBarTitle.foreground": "#00d4ff",
    "sideBarSectionHeader.background": "#03070e",

    // ---- Activity Bar ----
    "activityBar.background": "#03070e",
    "activityBar.foreground": "#00d4ff",
    "activityBar.border": "#2d4a6b",
    "activityBar.activeBorder": "#00d4ff",
    "activityBarBadge.background": "#00d4ff",
    "activityBarBadge.foreground": "#050a14",

    // ---- Tabs ----
    "tab.activeBackground": "#050a14",
    "tab.activeForeground": "#00d4ff",
    "tab.inactiveBackground": "#03070e",
    "tab.inactiveForeground": "#708090",
    "tab.activeBorderTop": "#00d4ff",
    "tab.border": "#2d4a6b",
    "editorGroupHeader.tabsBackground": "#03070e",

    // ---- Status Bar ----
    "statusBar.background": "#03070e",
    "statusBar.foreground": "#e0ecf4",
    "statusBar.border": "#2d4a6b",
    "statusBarItem.hoverBackground": "#00d4ff1e",

    // ---- Title Bar ----
    "titleBar.activeBackground": "#03070e",
    "titleBar.activeForeground": "#e0ecf4",
    "titleBar.inactiveBackground": "#03070e",
    "titleBar.inactiveForeground": "#708090",
    "titleBar.border": "#2d4a6b",

    // ---- Panel ----
    "panel.background": "#050a14",
    "panel.border": "#2d4a6b",
    "panelTitle.activeForeground": "#00d4ff",
    "panelTitle.activeBorder": "#00d4ff",
    "panelTitle.inactiveForeground": "#708090",

    // ---- Input Fields ----
    "input.background": "#03070e",
    "input.foreground": "#e0ecf4",
    "input.border": "#2d4a6b",
    "input.placeholderForeground": "#708090",
    "inputValidation.errorBorder": "#A167A5",
    "inputValidation.warningBorder": "#FDBD85",
    "inputValidation.infoBorder": "#87ceeb",

    // ---- Lists & Trees ----
    "list.activeSelectionBackground": "#2d4a6b",
    "list.activeSelectionForeground": "#e0ecf4",
    "list.focusBackground": "#2d4a6b50",
    "list.hoverBackground": "#2d4a6b3c",
    "list.highlightForeground": "#00d4ff",

    // ---- Scrollbar ----
    "scrollbarSlider.background": "#2d4a6b3c",
    "scrollbarSlider.hoverBackground": "#2d4a6b78",
    "scrollbarSlider.activeBackground": "#00d4ff"
}