// cobalt-next-neon theme for VS Code / Cursor
// Generated by the-themer — paste into "workbench.colorCustomizations"
{
    // ---- Terminal ----
    "terminal.background": "#142838",
    "terminal.foreground": "#b0d0c8",
    "terminal.selectionBackground": "#094fb1",
    "terminal.selectionForeground": "#b0d0c8",
    "terminalCursor.foreground": "#c4206f",
    "terminal.ansiBlack": "#142631",
    "terminal.ansiRed": "#ff2320",
    "terminal.ansiGreen": "#3ba5ff",
    "terminal.ansiYellow": "#e9e75c",
    "terminal.ansiBlue": "#8ff586",
    "terminal.ansiMagenta": "#781aa0",
    "terminal.ansiCyan": "#6bb6d6",
    "terminal.ansiWhite": "#a0b8c8",
    "terminal.ansiBrightBlack": "#3a5570",
    "terminal.ansiBrightRed": "#d4312e",
    "terminal.ansiBrightGreen": "#8ff586",
    "terminal.ansiBrightYellow": "#e9f06d",
    "terminal.ansiBrightBlue": "#3c7dd2",
    "terminal.ansiBrightMagenta": "#8230a7",
    "terminal.ansiBrightCyan": "#6cbc67",
    "terminal.ansiBrightWhite": "#b0d0c8",

    // ---- Editor ----
    "editor.background": "#142838",
    "editor.foreground": "#b0d0c8",
    "editorCursor.foreground": "#c4206f",
    "editor.selectionBackground": "#094fb1",
    "editor.lineHighlightBackground": "#1c384e28",
    "editorLineNumber.foreground": "#5a7a8a",
    "editorLineNumber.activeForeground": "#8ff586",
    "editorIndentGuide.background1": "#1e3a5028",
    "editorBracketMatch.background": "#8ff5861e",
    "editorBracketMatch.border": "#8ff586",

    // ---- Sidebar ----
    "sideBar.background": "#142838",
    "sideBar.foreground": "#b0d0c8",
    "sideBar.border": "#1e3a50",
    "sideBarTitle.foreground": "#8ff586",
    "sideBarSectionHeader.background": "#0e1c27",

    // ---- Activity Bar ----
    "activityBar.background": "#0e1c27",
    "activityBar.foreground": "#8ff586",
    "activityBar.border": "#1e3a50",
    "activityBar.activeBorder": "#8ff586",
    "activityBarBadge.background": "#8ff586",
    "activityBarBadge.foreground": "#142838",

    // ---- Tabs ----
    "tab.activeBackground": "#142838",
    "tab.activeForeground": "#8ff586",
    "tab.inactiveBackground": "#0e1c27",
    "tab.inactiveForeground": "#5a7a8a",
    "tab.activeBorderTop": "#e9e75c",
    "tab.border": "#1e3a50",
    "editorGroupHeader.tabsBackground": "#0e1c27",

    // ---- Status Bar ----
    "statusBar.background": "#0e1c27",
    "statusBar.foreground": "#b0d0c8",
    "statusBar.border": "#1e3a50",
    "statusBarItem.hoverBackground": "#8ff5861e",

    // ---- Title Bar ----
    "titleBar.activeBackground": "#0e1c27",
    "titleBar.activeForeground": "#b0d0c8",
    "titleBar.inactiveBackground": "#0e1c27",
    "titleBar.inactiveForeground": "#5a7a8a",
    "titleBar.border": "#1e3a50",

    // ---- Panel ----
    "panel.background": "#142838",
    "panel.border": "#1e3a50",
    "panelTitle.activeForeground": "#8ff586",
    "panelTitle.activeBorder": "#8ff586",
    "panelTitle.inactiveForeground": "#5a7a8a",

    // ---- Input Fields ----
    "input.background": "#0e1c27",
    "input.foreground": "#b0d0c8",
    "input.border": "#1e3a50",
    "input.placeholderForeground": "#5a7a8a",
    "inputValidation.errorBorder": "#ff2320",
    "inputValidation.warningBorder": "#e9e75c",
    "inputValidation.infoBorder": "#8ff586",

    // ---- Lists & Trees ----
    "list.activeSelectionBackground": "#094fb1",
    "list.activeSelectionForeground": "#b0d0c8",
    "list.focusBackground": "#094fb150",
    "list.hoverBackground": "#1e3a503c",
    "list.highlightForeground": "#8ff586",

    // ---- Scrollbar ----
    "scrollbarSlider.background": "#1e3a503c",
    "scrollbarSlider.hoverBackground": "#1e3a5078",
    "scrollbarSlider.activeBackground": "#8ff586",

    // ---- Editor Highlights (tame yellows) ----
    "editor.findMatchBackground": "#8ff58628",
    "editor.findMatchHighlightBackground": "#8ff58614",
    "editor.wordHighlightBackground": "#8ff58614",
    "editor.wordHighlightStrongBackground": "#8ff5861e",

    // ---- Badges ----
    "badge.background": "#8ff586",
    "badge.foreground": "#142838",

    // ---- Git Decorations ----
    "gitDecoration.modifiedResourceForeground": "#8ff586",
    "gitDecoration.untrackedResourceForeground": "#3ba5ff",
    "gitDecoration.deletedResourceForeground": "#ff2320",
    "gitDecoration.conflictingResourceForeground": "#e9e75c",
    "gitDecoration.ignoredResourceForeground": "#5a7a8a",

    // ---- Notifications ----
    "notificationCenter.border": "#1e3a50",
    "notifications.background": "#0e1c27",
    "notifications.foreground": "#b0d0c8",
    "notifications.border": "#1e3a50",

    // ---- Peek View ----
    "peekView.border": "#8ff586",
    "peekViewEditor.background": "#0e1c27",
    "peekViewResult.background": "#0e1c27",
    "peekViewTitle.background": "#0e1c27",
    "peekViewResult.matchHighlightBackground": "#8ff5861e",

    // ---- Diff Editor ----
    "diffEditor.insertedTextBackground": "#3ba5ff14",
    "diffEditor.removedTextBackground": "#ff232014"
}