// cobalt-next-neon theme for VS Code / Cursor
// Generated by the-themer — paste into "workbench.colorCustomizations"
{
    // ---- Terminal ----
    "terminal.background": "#142838",
    "terminal.foreground": "#8ff586",
    "terminal.selectionBackground": "#094fb1",
    "terminal.selectionForeground": "#8ff586",
    "terminalCursor.foreground": "#c4206f",
    "terminal.ansiBlack": "#142631",
    "terminal.ansiRed": "#ff2320",
    "terminal.ansiGreen": "#3ba5ff",
    "terminal.ansiYellow": "#e9e75c",
    "terminal.ansiBlue": "#8ff586",
    "terminal.ansiMagenta": "#781aa0",
    "terminal.ansiCyan": "#8ff586",
    "terminal.ansiWhite": "#ba46b2",
    "terminal.ansiBrightBlack": "#fff688",
    "terminal.ansiBrightRed": "#d4312e",
    "terminal.ansiBrightGreen": "#8ff586",
    "terminal.ansiBrightYellow": "#e9f06d",
    "terminal.ansiBrightBlue": "#3c7dd2",
    "terminal.ansiBrightMagenta": "#8230a7",
    "terminal.ansiBrightCyan": "#6cbc67",
    "terminal.ansiBrightWhite": "#8ff586",

    // ---- Editor ----
    "editor.background": "#142838",
    "editor.foreground": "#8ff586",
    "editorCursor.foreground": "#c4206f",
    "editor.selectionBackground": "#094fb1",
    "editor.lineHighlightBackground": "#1c384e28",
    "editorLineNumber.foreground": "#fff688",
    "editorLineNumber.activeForeground": "#8ff586",
    "editorIndentGuide.background1": "#fff68828",
    "editorBracketMatch.background": "#8ff5861e",
    "editorBracketMatch.border": "#8ff586",

    // ---- Sidebar ----
    "sideBar.background": "#142838",
    "sideBar.foreground": "#8ff586",
    "sideBar.border": "#fff688",
    "sideBarTitle.foreground": "#8ff586",
    "sideBarSectionHeader.background": "#0e1c27",

    // ---- Activity Bar ----
    "activityBar.background": "#0e1c27",
    "activityBar.foreground": "#8ff586",
    "activityBar.border": "#fff688",
    "activityBar.activeBorder": "#8ff586",
    "activityBarBadge.background": "#8ff586",
    "activityBarBadge.foreground": "#142838",

    // ---- Tabs ----
    "tab.activeBackground": "#142838",
    "tab.activeForeground": "#8ff586",
    "tab.inactiveBackground": "#0e1c27",
    "tab.inactiveForeground": "#fff688",
    "tab.activeBorderTop": "#8ff586",
    "tab.border": "#fff688",
    "editorGroupHeader.tabsBackground": "#0e1c27",

    // ---- Status Bar ----
    "statusBar.background": "#0e1c27",
    "statusBar.foreground": "#8ff586",
    "statusBar.border": "#fff688",
    "statusBarItem.hoverBackground": "#8ff5861e",

    // ---- Title Bar ----
    "titleBar.activeBackground": "#0e1c27",
    "titleBar.activeForeground": "#8ff586",
    "titleBar.inactiveBackground": "#0e1c27",
    "titleBar.inactiveForeground": "#fff688",
    "titleBar.border": "#fff688",

    // ---- Panel ----
    "panel.background": "#142838",
    "panel.border": "#fff688",
    "panelTitle.activeForeground": "#8ff586",
    "panelTitle.activeBorder": "#8ff586",
    "panelTitle.inactiveForeground": "#fff688",

    // ---- Input Fields ----
    "input.background": "#0e1c27",
    "input.foreground": "#8ff586",
    "input.border": "#fff688",
    "input.placeholderForeground": "#fff688",
    "inputValidation.errorBorder": "#ff2320",
    "inputValidation.warningBorder": "#e9e75c",
    "inputValidation.infoBorder": "#8ff586",

    // ---- Lists & Trees ----
    "list.activeSelectionBackground": "#094fb1",
    "list.activeSelectionForeground": "#8ff586",
    "list.focusBackground": "#094fb150",
    "list.hoverBackground": "#fff6883c",
    "list.highlightForeground": "#8ff586",

    // ---- Scrollbar ----
    "scrollbarSlider.background": "#fff6883c",
    "scrollbarSlider.hoverBackground": "#fff68878",
    "scrollbarSlider.activeBackground": "#8ff586"
}